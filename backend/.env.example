# .env.example

# App
APP_NAME=Personal AI Agent
APP_ENV=development
DEBUG=True
DEV_AUTH_BYPASS=True
DEV_USER_INTERNAL_ID=11111111-1111-1111-1111-111111111111

# Auth
SECRET_KEY=a_very_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SECURE_COOKIES=False

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1,test,*
HOST=http://localhost:8000

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=personal_ai_agent
# POSTGRES_SSL_MODE=require
# POSTGRES_SSL_ROOT_CERT=path/to/ca.pem

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_USER=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=google/gemini-2.5-flash
OPENROUTER_FALLBACK_MODELS=openai/gpt-4o,meta-llama/llama-3-70b-instruct

# Clerk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_ISSUER=

# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=

# Notion
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_TOKEN=

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ACCESS_TOKEN=
GMAIL_ACCESS_TOKEN=
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/calendar.readonly https://www.googleapis.com/auth/gmail.readonly

# Test Data
GITHUB_TEST_OWNER=octocat
GITHUB_TEST_REPO=Hello-World
NOTION_TEST_DATABASE_ID=

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Task Execution
MAX_TASKS_PER_REQUEST=10
TASK_TIMEOUT_SECONDS=30
MAX_EXECUTION_ITERATIONS=50
