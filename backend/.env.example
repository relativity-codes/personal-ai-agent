APP_NAME=Personal AI Agent
APP_ENV=development
DEBUG=true
DEV_AUTH_BYPASS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1,*

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=personal_ai_agent

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3.5-sonnet

CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=

NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Space-separated scopes for GET /api/v1/mcp/oauth/google/authorize-url (defaults include Calendar + Gmail readonly).
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/calendar.readonly https://www.googleapis.com/auth/gmail.readonly
# From OAuth consent (offline access); app exchanges this + client id/secret for short-lived access tokens.
GOOGLE_REFRESH_TOKEN=
# Optional override: paste a Calendar access token instead of using refresh exchange.
GOOGLE_CALENDAR_ACCESS_TOKEN=

# OAuth access token with Gmail scope (e.g. https://www.googleapis.com/auth/gmail.readonly)
GMAIL_ACCESS_TOKEN=

# Pytest live MCP tests (optional; real API calls)
GITHUB_TEST_OWNER=octocat
GITHUB_TEST_REPO=Hello-World
NOTION_TEST_DATABASE_ID=

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
MAX_TASKS_PER_REQUEST=10
TASK_TIMEOUT_SECONDS=30
MAX_EXECUTION_ITERATIONS=50
