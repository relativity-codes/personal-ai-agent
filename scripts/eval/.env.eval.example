# Copy to .env.eval (gitignored locally) and `set -a; source scripts/eval/.env.eval; set +a`
# or export manually before running run_batch.py

# Running FastAPI server root (no trailing slash required; script normalizes)
EVAL_BASE_URL=http://127.0.0.1:8000

# Optional: Clerk session JWT when DEV_AUTH_BYPASS=false
# EVAL_AUTH_HEADER=Bearer <token>

# Required for LLM-as-judge (skip with run_batch.py --no-judge)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EVAL_JUDGE_MODEL=anthropic/claude-3.5-haiku
